# Facit Modern — NammaQr (see FACIT_INSTALLATION.md)
# Vite maps VITE_* → process.env.REACT_APP_* in vite.config.ts

VITE_MODERN_DESIGN=true
VITE_ASIDE_TOUCH_STATUS=true
VITE_DARK_MODE=false
VITE_MOBILE_BREAKPOINT_SIZE=768
VITE_ASIDE_MINIMIZE_BREAKPOINT_SIZE=1024
VITE_ASIDE_WIDTH_PX=240
VITE_SPACER_PX=16
VITE_META_DESC=NammaQr Restaurant Management

# NammaQR Design System
VITE_PRIMARY_COLOR=#0A5D3B
VITE_SECONDARY_COLOR=#064028
VITE_SUCCESS_COLOR=#16A34A
VITE_INFO_COLOR=#0A5D3B
VITE_WARNING_COLOR=#F59E0B
VITE_DANGER_COLOR=#EF4444
VITE_LIGHT_COLOR=#F4F8F5
VITE_DARK_COLOR=#111827
